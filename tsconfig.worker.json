{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["worker/**/*.ts", "db/**/*.ts", "shared/**/*.ts", "server/services/**/*.ts"],
  "exclude": ["server/services/storage/index.ts"]
}
