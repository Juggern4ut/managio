# Postgres connection used by both the app and drizzle-kit
DATABASE_URL=postgresql://managio:managio@localhost:5432/managio

# Used by docker-compose to provision the postgres container
POSTGRES_USER=managio
POSTGRES_PASSWORD=managio
POSTGRES_DB=managio

# Session cookie encryption key for nuxt-auth-utils (32+ random characters)
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-character-string

# Single admin user. Generate the hash with: npm run auth:hash -- "your-password"
# Note: if you run the app via `docker compose up` (not just `up -d db`), Compose
# interpolates $ in env_file values, so paste the "docker compose" variant the
# script prints (every literal $ doubled as $$). For plain `npm run dev` use the
# other variant as-is.
NUXT_AUTH_USERNAME=admin
NUXT_AUTH_PASSWORD_HASH=

# "pretty" for human-readable dev logs, "json" for structured production logs
NUXT_LOG_FORMAT=pretty

# Where original documents are stored (filesystem storage for now; hidden
# behind a storage interface so this can move to MinIO/S3 later)
NUXT_STORAGE_DIR=./data/documents
